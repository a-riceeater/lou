# /etc/lou/lou.env — production environment for the Lou server (chmod 640, owner root:lou).
LOU_ENV=production
LOU_HOST=127.0.0.1
LOU_PORT=8787
# Public HTTPS URL served by your reverse proxy or tunnel (used for OAuth redirects and webhooks).
LOU_PUBLIC_URL=https://lou.example.com
LOU_TRUST_PROXY=true
LOU_DATA_DIR=/var/lib/lou
LOU_DB_PATH=/var/lib/lou/lou.db
LOU_SKILLS_DIR=/opt/lou/skills
LOU_LOG_LEVEL=info
LOU_USER_NAME=Your Name
LOU_TIMEZONE=America/New_York

# 32-byte base64 key that encrypts OAuth tokens and device keys at rest.
# Generate once with: node /opt/lou/apps/server/dist/cli.js gen-key
# Losing it means reconnecting accounts and re-pairing devices.
LOU_MASTER_KEY=

# Model provider: openai_api (API key below) or codex_cli (the lou user's `codex login`).
# See docs/MODEL_PROVIDERS.md. Switchable at runtime in Settings → Assistant model.
AI_PROVIDER=openai_api
# CODEX_PATH=/usr/bin/codex
# LOU_CODEX_MODEL=

# OpenAI API provider (default model: GPT-6 Luna). Not required when AI_PROVIDER=codex_cli.
OPENAI_API_KEY=
LOU_MODEL=gpt-6-luna
# LOU_ESCALATION_MODEL=gpt-6-sol
# LOU_CLASSIFIER_MODEL=
LOU_EMBEDDING_MODEL=text-embedding-3-small
LOU_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Gmail (Google Cloud OAuth client, type "Web application").
# Redirect URI: ${LOU_PUBLIC_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOU_GMAIL_POLL_SECONDS=120

# Instagram (Meta app with Instagram API + Instagram Login).
# Redirect URI: ${LOU_PUBLIC_URL}/oauth/instagram/callback ; Webhook: ${LOU_PUBLIC_URL}/webhooks/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# MCP servers (e.g. Zapier MCP); secrets referenced from this file as ${VAR}.
# LOU_MCP_CONFIG=/etc/lou/mcp.json
# ZAPIER_MCP_URL=
LOU_IMPROVEMENT_ENABLED=true
