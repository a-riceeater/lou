# systemd unit for the Lou assistant server.
# Install: see docs/DEPLOYMENT.md (copy to /etc/systemd/system/lou.service).
[Unit]
Description=Lou personal assistant server
Documentation=file:///opt/lou/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lou
Group=lou
WorkingDirectory=/opt/lou
EnvironmentFile=/etc/lou/lou.env
ExecStart=/usr/bin/node --enable-source-maps /opt/lou/apps/server/dist/index.js
# Graceful shutdown: the server drains HTTP/WebSocket and closes SQLite on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# Logs go to the journal: journalctl -u lou -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lou

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lou
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
