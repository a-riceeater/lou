# Development environment. Copy to apps/server/.env (read by `npm run dev`).
# Production uses /etc/lou/lou.env — see deploy/lou.env.example and docs/DEPLOYMENT.md.
LOU_ENV=development
LOU_HOST=127.0.0.1
LOU_PORT=8787
# Google only accepts localhost (not 127.0.0.1) redirect URIs for local testing.
LOU_PUBLIC_URL=http://localhost:8787
LOU_DATA_DIR=./data
LOU_LOG_LEVEL=debug
LOU_USER_NAME=Your Name
# Allow the browser dev UI (vite) to call the server directly:
LOU_CORS_ORIGINS=http://localhost:5173

# Model provider: openai_api (OPENAI_API_KEY), codex_cli (your existing `codex login`)
# or claude_cli (your existing `claude auth login`).
# Switchable at runtime in Settings → Assistant model. See docs/MODEL_PROVIDERS.md.
AI_PROVIDER=openai_api

# OpenAI API provider. Without a key (and without Codex or Claude Code) agent requests report that no model is configured.
OPENAI_API_KEY=
LOU_MODEL=gpt-6-luna

# Codex CLI provider (install: npm install -g @openai/codex && codex login)
# CODEX_PATH=
# LOU_CODEX_MODEL=

# Claude Code provider (install: npm install -g @anthropic-ai/claude-code && claude auth login)
# CLAUDE_PATH=
# LOU_CLAUDE_MODEL=sonnet

# Gmail: Google Cloud OAuth client (Web application) with redirect URI
#   http://localhost:8787/oauth/google/callback
# Optional: it can also be entered in the app (Accounts → Add Gmail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify (developer.spotify.com/dashboard → Web API). Spotify rejects localhost, so register
#   http://127.0.0.1:8787/oauth/spotify/callback
# Or leave these empty and use the Windows app: Accounts → Spotify → Set up.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# LOU_MCP_CONFIG=../../deploy/mcp.example.json
# LOU_MASTER_KEY is generated into ./data/master.key automatically in development.
