# Development environment. Copy to apps/server/.env (read by `npm run dev`).
# Production uses /etc/lou/lou.env — see deploy/lou.env.example and docs/DEPLOYMENT.md.
LOU_ENV=development
LOU_HOST=127.0.0.1
LOU_PORT=8787
# Google only accepts localhost (not 127.0.0.1) redirect URIs for local testing.
LOU_PUBLIC_URL=http://localhost:8787
LOU_DATA_DIR=./data
LOU_LOG_LEVEL=debug
LOU_USER_NAME=Your Name
# Allow the browser dev UI (vite) to call the server directly:
LOU_CORS_ORIGINS=http://localhost:5173

# Model provider: openai_api (OPENAI_API_KEY) or codex_cli (your existing `codex login`).
# Switchable at runtime in Settings → Assistant model. See docs/MODEL_PROVIDERS.md.
AI_PROVIDER=openai_api

# OpenAI API provider. Without a key (and without Codex) agent requests report that no model is configured.
OPENAI_API_KEY=
LOU_MODEL=gpt-6-luna

# Codex CLI provider (install: npm install -g @openai/codex && codex login)
# CODEX_PATH=
# LOU_CODEX_MODEL=

# Gmail: Google Cloud OAuth client (Web application) with redirect URI
#   http://localhost:8787/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# LOU_MCP_CONFIG=../../deploy/mcp.example.json
# LOU_MASTER_KEY is generated into ./data/master.key automatically in development.
