<Project Sdk="Microsoft.NET.Sdk">
  <!-- Trusted local device agent: protocol, credentials, command verification and device tools. No UI. -->
  <PropertyGroup>
    <RootNamespace>Lou.Agent</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lou.Agent.Tests" />
  </ItemGroup>
</Project>
